  "license": "MIT",
  "keywords": [
    "tailwindcss",
    "tailwind",
    "css",
    "utility-first",
    "v4.1",
    "oxide-engine",
    "theme",
    "directives",
    "responsive",
    "dark-mode",
    "oklch",
    "container-queries",
    "flexbox",
    "grid",
    "typography",
    "animations"
  ],
  "skills": "./skills/",
  "interface": {
    "displayName": "Tailwindcss",
    "shortDescription": "Expert Tailwind CSS v4.1 - CSS-first configuration, @theme, @utility, @variant, Oxide engine 5x faster, OKLCH colors,...",
    "developerName": "Fusengine"
  },
  "hooks": [
    {
      "event": "PreToolUse",
      "matcher": "Write|Edit",
      "command": "bun \"${KIMI_PLUGIN_ROOT}/scripts/kimi-hook-shim.mjs\" tailwindcss"
    },
    {
      "event": "PostToolUse",
      "matcher": "",
      "command": "bun \"${KIMI_PLUGIN_ROOT}/scripts/kimi-hook-shim.mjs\" tailwindcss"
    }
  ]
}
