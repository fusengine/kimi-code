{
  "name": "core-guards",
  "version": "1.1.36",
  "description": "Core security guards (git, install, security) and SOLID enforcement hooks for Kimi Code",
  "author": {
    "name": "Fusengine",
    "email": "hello@fusengine.ch",
    "url": "https://github.com/fusengine"
  },
  "repository": "https://github.com/fusengine/agents",
  "homepage": "https://github.com/fusengine/agents",
  "license": "MIT",
  "keywords": [
    "security",
    "guards",
    "solid",
    "hooks",
    "git",
    "linter",
    "pre-commit"
  ],
  "interface": {
    "displayName": "Core Guards",
    "shortDescription": "Core security guards (git, install, security) and SOLID enforcement hooks for Kimi Code",
    "developerName": "Fusengine"
  },
  "hooks": [
    {
      "event": "PreToolUse",
      "matcher": "Write|Edit|Bash|FetchURL|mcp__context7__query-docs|mcp__exa__web_search_exa|mcp__exa__get_code_context_exa",
      "command": "bun \"${KIMI_PLUGIN_ROOT}/scripts/kimi-hook-shim.mjs\" core"
    },
    {
      "event": "PostToolUse",
      "matcher": "",
      "command": "bun \"${KIMI_PLUGIN_ROOT}/scripts/kimi-hook-shim.mjs\" core"
    },
    {
      "event": "SessionStart",
      "matcher": "",
      "command": "bun \"${KIMI_PLUGIN_ROOT}/scripts/kimi-hook-shim.mjs\" core"
    },
    {
      "event": "UserPromptSubmit",
      "matcher": "",
      "command": "bun \"${KIMI_PLUGIN_ROOT}/scripts/kimi-hook-shim.mjs\" core"
    },
    {
      "event": "SubagentStart",
      "matcher": "",
      "command": "bun \"${KIMI_PLUGIN_ROOT}/scripts/kimi-hook-shim.mjs\" core"
    },
    {
      "event": "SubagentStop",
      "matcher": "",
      "command": "bun \"${KIMI_PLUGIN_ROOT}/scripts/kimi-hook-shim.mjs\" core"
    },
    {
      "event": "SubagentStop",
      "matcher": "",
      "command": "bun \"${KIMI_PLUGIN_ROOT}/scripts/kimi-hook-shim.mjs\" core"
    },
    {
      "event": "Notification",
      "matcher": "task\\.completed",
      "command": "bun \"${KIMI_PLUGIN_ROOT}/scripts/kimi-hook-shim.mjs\" core"
    },
    {
      "event": "PostToolUseFailure",
      "matcher": "",
      "command": "bun \"${KIMI_PLUGIN_ROOT}/scripts/kimi-hook-shim.mjs\" core"
    },
    {
      "event": "Stop",
      "matcher": "",
      "command": "bun \"${KIMI_PLUGIN_ROOT}/scripts/kimi-hook-shim.mjs\" core --sound stop"
    },
    {
      "event": "PermissionRequest",
      "matcher": "",
      "command": "bun \"${KIMI_PLUGIN_ROOT}/scripts/kimi-hook-shim.mjs\" core --sound permission"
    },
    {
      "event": "PreCompact",
      "matcher": "",
      "command": "bun \"${KIMI_PLUGIN_ROOT}/scripts/kimi-hook-shim.mjs\" core"
    },
    {
      "event": "SessionEnd",
      "matcher": "",
      "command": "bun \"${KIMI_PLUGIN_ROOT}/scripts/kimi-hook-shim.mjs\" core"
    },
    {
      "event": "SessionStart",
      "matcher": "",
      "command": "bun \"${KIMI_PLUGIN_ROOT}/scripts/kimi-hook-shim.mjs\" core"
    },
    {
      "event": "Notification",
      "matcher": "permission_prompt",
      "command": "bun \"${KIMI_PLUGIN_ROOT}/scripts/kimi-hook-shim.mjs\" core --sound permission"
    },
    {
      "event": "Notification",
      "matcher": "idle_prompt",
      "command": "bun \"${KIMI_PLUGIN_ROOT}/scripts/kimi-hook-shim.mjs\" core --sound human"
    },
    {
      "event": "Notification",
      "matcher": "elicitation_dialog",
      "command": "bun \"${KIMI_PLUGIN_ROOT}/scripts/kimi-hook-shim.mjs\" core --sound human"
    }
  ]
}
